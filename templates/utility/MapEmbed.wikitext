<noinclude>
Embeds an interactive map viewport directly into a Wiki page.
Usage: {{MapEmbed|x=260|z=156|zoom=3.0|width=100%|height=600px|map=surface|object=Mithril Rock}}
</noinclude><includeonly><div class="wiki-map-embed-container" style="width: {{{width|100%}}}; margin: 1em 0; border: 1px solid #334155; border-radius: 8px; overflow: hidden; background: #090c10; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);">
  <div style="background: #1e293b; padding: 8px 14px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #334155;">
    <div style="display: flex; align-items: center; gap: 8px; font-weight: bold; color: #f8fafc; font-size: 0.95em;">
      <span>🗺️</span>
      <span>Interactive World Map</span>
      {{#if: {{{object|}}} | <span style="background: #3b82f6; color: white; font-size: 0.75em; padding: 2px 6px; border-radius: 4px;">{{{object}}}</span> }}
    </div>
    <div class="plainlinks" style="font-size: 0.85em;">
      [https://map.memoriesofmagic.wiki/?{{#if: {{{object|}}} | object={{urlencode:{{{object}}}}}& }}{{#if: {{{map|}}} | map={{{map}}}& }}{{#if: {{{x|}}} | x={{{x}}}& }}{{#if: {{{z|}}} | z={{{z}}}& }}{{#if: {{{zoom|}}} | zoom={{{zoom}}}& }}embed=false <span style="color: #60a5fa; text-decoration: underline; font-weight: bold;">Open Full Map ↗</span>]
    </div>
  </div>
  <iframe 
    src="https://map.memoriesofmagic.wiki/?{{#if: {{{object|}}} | object={{urlencode:{{{object}}}}}&amp; }}{{#if: {{{map|}}} | map={{{map}}}&amp; }}{{#if: {{{x|}}} | x={{{x}}}&amp; }}{{#if: {{{z|}}} | z={{{z}}}&amp; }}{{#if: {{{zoom|}}} | zoom={{{zoom}}}&amp; }}embed=true" 
    style="width: 100%; height: {{{height|600px}}}; border: none; display: block;" 
    loading="lazy" 
    allow="clipboard-write"
    title="Memories of Magic Interactive Map">
  </iframe>
</div></includeonly>
